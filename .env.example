# posting_auto 환경 변수 템플릿
# 이 파일을 복사해 .env 로 만든 뒤 값을 채우세요. (.env 는 git에 커밋되지 않습니다)
# 값은 따옴표 없이 그대로 입력합니다.

# OpenAI (필수)
OPENAI_API_KEY=

# WordPress (발행·재최적화 시 필수)
WP_DOMAIN=example.com
WP_USER=
WP_APP_PASSWORD=

# Pixabay (with_image + image_source=pixabay 사용 시 필수)
PIXABAY_API_KEY=

# OpenAI 모델 (선택, 기본값: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
